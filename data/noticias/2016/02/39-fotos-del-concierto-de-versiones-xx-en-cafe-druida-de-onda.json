  "post_title": "39 fotos del concierto de Versiones XX en Cafè Druida de Onda",
  "post_date": "2016-02-13 13:48:46",
  "post_name": "39-fotos-del-concierto-de-versiones-xx-en-cafe-druida-de-onda",
  "autor": "redaccion",
  "imagen_destacada_id": "NULL",
