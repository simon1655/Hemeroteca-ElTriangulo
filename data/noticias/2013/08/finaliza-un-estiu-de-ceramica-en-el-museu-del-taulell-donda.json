  "post_title": "Finaliza 'Un Estiu de Ceràmica' en el Museu del Taulell d'Onda",
  "post_date": "2013-08-23 13:36:20",
  "post_name": "finaliza-un-estiu-de-ceramica-en-el-museu-del-taulell-donda",
