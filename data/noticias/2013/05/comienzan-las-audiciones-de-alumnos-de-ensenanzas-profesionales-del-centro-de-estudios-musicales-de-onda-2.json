  "post_title": "Comienzan las audiciones de alumnos de enseñanzas profesionales del Centro de Estudios Musicales de Onda",
  "post_date": "2013-05-21 12:40:13",
  "post_name": "comienzan-las-audiciones-de-alumnos-de-ensenanzas-profesionales-del-centro-de-estudios-musicales-de-onda-2",
  "autor": "redaccion",
  "imagen_destacada_id": "NULL",
