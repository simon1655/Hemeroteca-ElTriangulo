  "imagen_destacada_id": "NULL",
  "categorias": "Fiestas|Noticias",
  "post_content": "<p><img alt=\"\" src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/2014/07/PresenReinaBarriRavalCastell-9.jpg\" style=\"width: 480px; height: 720px;\" /></p>\n<p><span style=\"font-size:14px;\"><span style=\"font-family:arial,helvetica,sans-serif;\">La noche de este viernes se han iniciado las fiestas del barrio del Arrabal del Castillo, en Onda, de manera solemne con la presentaci&oacute;n de la reina, Ana Gargallo Porcar, que lo ser&aacute; tambi&eacute;n de la Fira 2014. Ha presentado el acto Ver&oacute;nica Cons y ha actuado de mantenedor el senador Enrique Navarro Andreu, que ha repasado algunas de las realizaciones en el barrio durante su &eacute;poca de alcalde. En las calles, gran animaci&oacute;n con cenas y alguna actuaci&oacute;n, paralela al concierto de Los Makis en la pista.</span></span></p>\n<p></p>\n<div class=\"galeria-ngg\" style=\"display:flex;flex-wrap:wrap;gap:8px;\"><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/presenreinabarriravalcastell14/img_9928.jpg\" alt=\"img_9928\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/presenreinabarriravalcastell14/img_9930.jpg\" alt=\"img_9930\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/presenreinabarriravalcastell14/img_9934.jpg\" alt=\"img_9934\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/presenreinabarriravalcastell14/img_9935.jpg\" alt=\"img_9935\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/presenreinabarriravalcastell14/img_9936.jpg\" alt=\"img_9936\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/presenreinabarriravalcastell14/img_9937.jpg\" alt=\"img_9937\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/presenreinab