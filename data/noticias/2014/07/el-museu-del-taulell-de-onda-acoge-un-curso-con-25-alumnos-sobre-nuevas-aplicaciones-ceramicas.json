  "post_content": "<p align=\"justify\" class=\"western\" lang=\"es-ES\" style=\"margin: 0px 0px 0cm; padding: 0px; font-size: 13px; text-align: justify; widows: 2; orphans: 2;\"><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:14px;\"><font style=\"font-size: 12pt;\">El Museu del Taulell &#39;Manolo Safont&#39; de Onda acoge todo este viernes un nuevo curso organizado por Proalso, en colaboraci&oacute;n con el Ayuntamiento del municipio, al que asisten 25 profesionales del sector de la construcci&oacute;n.</font></span></span></p><div class=\"galeria-ngg\" style=\"display:flex;flex-wrap:wrap;gap:8px;\"><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/carsproalsomuseutaulell250714/cursproalsomuseutaulellonda2.jpg\" alt=\"cursproalsomuseutaulellonda2\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/carsproalsomuseutaulell250714/img_2788.jpg\" alt=\"img_2788\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/carsproalsomuseutaulell250714/img_2791.jpg\" alt=\"img_2791\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/carsproalsomuseutaulell250714/img_2793.jpg\" alt=\"img_2793\" style=\"max-width:100%;height:auto;\" /></div>"
