  "imagen_destacada_id": "NULL",
  "categorias": "Cultura y Espectáculos|Educación|Imágenes|Noticias|Política",
  "post_content": "<p><img alt=\"\" src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/2014/06/IMG_3499.jpg\" style=\"width: 480px; height: 320px;\" /></p>\n<p><span style=\"font-size:14px;\"><span style=\"font-family:arial,helvetica,sans-serif;\">La tarde de este viernes se ha inaugurado en el Museu del Taulell &#39;Manolo Safont&#39; de Onda la exposici&oacute;n de los trabajos realizados por el alumnado de las actividades formativas municipales, organizadas por el &aacute;rea de Educaci&oacute;n del Ayuntamiento y gestionadas este curso por la empresa Eulen. La completa muestra estar&aacute; abierta hasta el domingo 15 de junio en el horario habitual del Museo.</span></span></p>\n<p></p>\n<div class=\"galeria-ngg\" style=\"display:flex;flex-wrap:wrap;gap:8px;\"><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/expoactivitatsformatives14/img_3456.jpg\" alt=\"img_3456\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/expoactivitatsformatives14/img_3458.jpg\" alt=\"img_3458\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/expoactivitatsformatives14/img_3459.jpg\" alt=\"img_3459\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/expoactivitatsformatives14/img_3460.jpg\" alt=\"img_3460\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/expoactivitatsformatives14/img_3461.jpg\" alt=\"img_3461\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/expoactivitatsformatives14/img_3462.jpg\" alt=\"img_3462\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/expoactivitatsformatives14/img_3463.jpg\" alt=\"img_3463\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/expoactivitatsformati