  "post_title": "Exposición de actividades formativas municipales de Onda en el Museu del Taulell 'Manolo Safont'",
  "post_date": "2014-06-06 20:49:10",
  "post_name": "exposicion-de-actividades-formativas-municipales-de-onda-en-el-museu-del-taulell-manolo-safont",
