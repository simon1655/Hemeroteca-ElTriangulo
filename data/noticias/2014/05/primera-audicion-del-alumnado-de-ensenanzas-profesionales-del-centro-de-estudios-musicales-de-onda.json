  "autor": "redaccion",
  "imagen_destacada_id": "NULL",
  "categorias": "Cultura y Espectáculos|Educación|Noticias",
  "post_content": "<p><span style=\"font-size:14px;\"><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"color: rgb(85, 85, 85); line-height: 21.33333396911621px;\">La tarde de este lunes se han iniciado en el auditorio de la Uni&oacute;n Musical Santa Cecilia de Onda las audiciones del alumnado de ense&ntilde;anzas profesionales del Centro de Estudios Musicales.</span></span></span></p>\n<p><span style=\"font-size:14px;\"><span style=\"font-family:arial,helvetica,sans-serif;\"><img alt=\"\" src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/2014/05/IMG_1049.jpg\" style=\"width: 480px; height: 320px;\" /></span></span></p>\n<p><span style=\"font-size:14px;\"><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"color: rgb(85, 85, 85); line-height: 21.33333396911621px;\">Alumnos y alumnas han ido subiendo al escenario para iniciar su interpretaci&oacute;n, empezando por el contrabajo. Este lunes tambi&eacute;n ha sido el turno de viol&iacute;n, viola y percusi&oacute;n. Las audiciones se repretir&aacute;n martes, mi&eacute;rcoles, jueves y viernes, tambi&eacute;n desde las 19.30 horas, para dar paso al resto de instrumentos.</span></span></span></p>\n<p></p>\n<div class=\"galeria-ngg\" style=\"display:flex;flex-wrap:wrap;gap:8px;\"><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1011.jpg\" alt=\"img_1011\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1012.jpg\" alt=\"img_1012\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1013.jpg\" alt=\"img_1013\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1014.jpg\" alt=\"img_1014\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1015.jpg\" alt=\"img_1015\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1017.jpg\" alt=\"img_1017\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1018.jpg\" alt=\"img_1018\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1019.jpg\" alt=\"img_1019\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1020.jpg\" alt=\"img_1020\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1021.jpg\" alt=\"img_1021\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1022.jpg\" alt=\"img_1022\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1023.jpg\" alt=\"img_1023\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1024.jpg\" alt=\"img_1024\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1025.jpg\" alt=\"img_1025\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1026.jpg\" alt=\"img_1026\" style=\"max-width:100%;height:auto;\" /><img src=\"https://pub-912f25dfbd4d4e8a976d0d4715439efb.r2.dev/audiciopercussiovioliviolacontrabaix/img_1027.jpg\" alt=\"img_10