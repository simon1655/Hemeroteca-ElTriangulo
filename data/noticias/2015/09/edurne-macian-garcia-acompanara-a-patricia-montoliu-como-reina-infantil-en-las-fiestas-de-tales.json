  "ID": "58288",
  "post_title": "Edurne Macián García acompañará a Patricia Montoliu como reina infantil en las fiestas de Tales",
  "post_date": "2015-09-01 20:37:02",
  "post_name": "edurne-macian-garcia-acompanara-a-patricia-montoliu-como-reina-infantil-en-las-fiestas-de-tales",
  "autor": "redaccion",
  "imagen_destacada_id": "NULL",
