  "post_title": "Quisqueya ONG de Onda celebra su Día de las Culturas",
  "post_date": "2015-06-20 15:16:35",
  "post_name": "quisqueya-ong-de-onda-celebra-su-dia-de-las-culturas",
  "autor": "redaccion",
