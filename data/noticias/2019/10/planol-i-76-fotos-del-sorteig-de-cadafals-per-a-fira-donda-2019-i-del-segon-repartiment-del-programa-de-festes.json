  "post_title": "Plànol i 76 fotos del sorteig de cadafals per a Fira d'Onda 2019 i del segon repartiment del programa de festes",
  "post_date": "2019-10-06 20:57:22",
  "post_name": "planol-i-76-fotos-del-sorteig-de-cadafals-per-a-fira-donda-2019-i-del-segon-repartiment-del-programa-de-festes",
  "autor": "redaccion",
